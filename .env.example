# Copy this file to ".env" and fill it in.

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional: your server ID. If set, slash commands show up instantly in that server.
# If empty, commands are registered globally (can take up to an hour to appear).
GUILD_ID=

# Role IDs of the compe team roles, separated by commas (right-click a role -> Copy Role ID).
# Optional: the easier way is to run /compe teams in Discord, which overrides this line.
# Needs "Server Members Intent" switched on for the bot in the developer portal.
TEAM_ROLE_IDS=

# Paid games per week for a category that has no cap of its own (set caps with /category set).
WEEKLY_CAP=3

# Team games per week (all team categories combined) a player needs to avoid the penalty.
WEEKLY_MINIMUM=2

# ECs deducted by /week penalize from players below the weekly minimum.
NO_PRACTICE_PENALTY=100
